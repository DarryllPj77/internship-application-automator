# Copy to .env. Single quotes preserve Windows backslashes and spaces.
CV_FILE_PATH='./uploads/resume.pdf'
# Use npx.cmd on Windows; npx on macOS/Linux.
MCP_SERVER_COMMAND=npx.cmd
MCP_SERVER_ARGS='["-y", "@gongrzhe/server-gmail-autoauth-mcp"]'

# Separate Desktop app OAuth client for read-only Google Sheets access.
SHEETS_CLIENT_FILE='./sheets-oauth-client.json'
# Optional defaults for the source panel. No credentials belong in these URLs.
SHEETS_URL=''

# Optional: automatic partner job discovery and company requirements searches.
# Company-name search links work without this key.
BRAVE_SEARCH_API_KEY=''

# Brave (default), SearXNG, or Hybrid (job-board site filters use SearXNG braveapi).
SEARCH_PROVIDER=Brave
SEARXNG_URL=http://127.0.0.1:8080
# General engines only; omit braveapi here to keep Hybrid's paid routing targeted.
SEARXNG_ENGINES=duckduckgo
